# Leave empty locally: Vite proxies /api to localhost:8080.
# On Vercel, set this to your Railway public HTTPS URL, then redeploy.
VITE_API_URL=

# The sign-in page shows a "Continue to demo" button (mock data) in development (npm run dev / start.ps1).
# Set to false to hide it locally. Production builds never show it, whatever this is set to.
VITE_AUTH_BYPASS=
