# Firebase Console > Project settings > General > Your apps > Web app config.
# Paste values without commas. These are public browser configuration values.
# Never put service-account private keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional for login; included to match the Firebase web configuration.
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Empty locally uses Vite's /api proxy. Set your deployed API origin on Vercel.
VITE_API_URL=
